
<!DOCTYPE html>
<html>
<head>
<title>Password Strength Analyzer</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: linear-gradient(120deg,#141e30,#243b55);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
}

.container {
    background: white;
    padding: 30px;
    border-radius: 15px;
    width: 350px;
    max-width: calc(100% - 60px);
    box-shadow: 0 5px 20px #0005;
}

h2 {
    text-align: center;
    color: #243b55;
}

input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    margin: 12px 0;
    border: 1px solid #aaa;
    border-radius: 6px;
    font-size: 16px;
}

button {
    width: 100%;
    padding: 12px;
    background: #2454d3;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 10px;
}

button:hover {
    background: #173ca5;
}

#bar {
    height: 10px;
    background: #ddd;
    border-radius: 10px;
    margin: 15px 0;
    overflow: hidden;
}

#progress {
    height: 100%;
    width: 0%;
    transition: 0.3s;
}

#result {
    text-align: center;
    font-weight: bold;
    font-size: 18px;
}

ul {
    padding-left: 20px;
    line-height: 1.8;
}

#suggestion {
    word-break: break-all;
    color: green;
    font-weight: bold;
}
</style>
</head>

<body>

<div class="container">

<h2>Password Strength Analyzer</h2>

<p>Enter your password:</p>

<input type="password" id="password"
placeholder="Enter password"
oninput="checkPassword()">

<label>
<input type="checkbox" id="show"
onchange="togglePassword()"
style="width:auto">
Show Password
</label>

<div id="bar">
<div id="progress"></div>
</div>

<p id="result">Password Strength: Not Checked</p>

<h3>Password Requirements</h3>

<ul>
<li id="length">❌ Minimum 8 characters</li>
<li id="upper">❌ Uppercase letter</li>
<li id="lower">❌ Lowercase letter</li>
<li id="number">❌ Number</li>
<li id="special">❌ Special character</li>
</ul>

<button onclick="generatePassword()">
Generate Strong Password
</button>

<p id="suggestion"></p>

<button onclick="copyPassword()">
Copy Generated Password
</button>

</div>

<script>

let generated = "";

function checkPassword() {

    let p = document.getElementById("password").value;
    let score = 0;

    let common = ["password", "12345678",
                  "qwerty", "admin"];

    let tests = [
        ["length", p.length >= 8],
        ["upper", /[A-Z]/.test(p)],
        ["lower", /[a-z]/.test(p)],
        ["number", /[0-9]/.test(p)],
        ["special", /[^A-Za-z0-9]/.test(p)]
    ];

    tests.forEach(([id, passed]) => {
        document.getElementById(id).innerHTML =
        (passed ? "✅ " : "❌ ") +
        document.getElementById(id).innerText.replace(
            /^[❌✅]\s*/, ""
        );

        if (passed) score++;
    });

    if (common.includes(p.toLowerCase()) ||
        (p.length > 0 && new Set(p).size <= 2)) {
        score = 0;
    }

    let result = document.getElementById("result");
    let progress = document.getElementById("progress");

    if (p.length === 0) {
        result.innerText = "Password Strength: Not Checked";
        progress.style.width = "0%";
        progress.style.background = "#ddd";
    }
    else if (score <= 2) {
        result.innerText = "Password Strength: WEAK";
        progress.style.width = "33%";
        progress.style.background = "red";
    }
    else if (score <= 4) {
        result.innerText = "Password Strength: MEDIUM";
        progress.style.width = "66%";
        progress.style.background = "orange";
    }
    else {
        result.innerText = "Password Strength: STRONG";
        progress.style.width = "100%";
        progress.style.background = "green";
    }
}

function togglePassword() {
    let p = document.getElementById("password");
    p.type = p.type === "password" ? "text" : "password";
}

function generatePassword() {

    let chars =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
    "abcdefghijklmnopqrstuvwxyz" +
    "0123456789!@#$%&*";

    let p = "";

    do {
        let values = new Uint32Array(16);
        crypto.getRandomValues(values);

        p = Array.from(values,
            n => chars[n % chars.length]).join("");

    } while (
        !/[A-Z]/.test(p) ||
        !/[a-z]/.test(p) ||
        !/[0-9]/.test(p) ||
        !/[^A-Za-z0-9]/.test(p)
    );

    generated = p;

    document.getElementById("suggestion").innerText =
    "Suggested Password: " + p;
}

function copyPassword() {

    if (!generated) {
        alert("Generate a password first!");
        return;
    }

    navigator.clipboard.writeText(generated)
    .then(() => alert("Password copied!"))
    .catch(() => alert("Copy is unavailable in this browser."));
}

</script>

</body>
</html>
